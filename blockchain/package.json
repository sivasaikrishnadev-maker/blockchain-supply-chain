{
  "name": "@workspace/blockchain",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile --config hardhat.config.cjs",
    "test": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test --config hardhat.config.cjs",
    "node": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat node --config hardhat.config.cjs --hostname 127.0.0.1",
    "deploy:local": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run --config hardhat.config.cjs scripts/deploy.cjs --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "chai": "^4.5.0",
    "hardhat": "^2.22.18"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  }
}