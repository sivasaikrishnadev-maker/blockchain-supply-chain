# =============================================================================
# Blockchain-Based Supply Chain Tracking - environment variable reference
# =============================================================================
#
# This file contains VARIABLE NAMES AND SAFE PLACEHOLDERS ONLY.
# Never put a real password, private key, connection string, or API token here.
#
# How to use:
#   * Locally:      copy to `.env` and fill it in (`.env` is git-ignored).
#   * On Render:    set these in Dashboard -> Environment for the web service.
#                   Do NOT commit the real values to GitHub.
#
# Legend
#   [required]  the server refuses to start without it in production
#   [secret]    never printed, never committed, treat a leak as a compromise
#   [optional]  has a safe default or only applies to a specific mode
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Drizzle)
# -----------------------------------------------------------------------------

# [required] [secret]
# Full PostgreSQL connection string including credentials, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# A managed free-tier database is required. This is the only place application
# data is stored; the container filesystem is not durable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# [optional]
# Maximum pooled connections. Defaults to 5. Keep it low on a free tier.
DATABASE_POOL_MAX=5

# -----------------------------------------------------------------------------
# Sessions / authentication
# -----------------------------------------------------------------------------

# [required] [secret]
# Signs the session tokens. Must be at least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every issued session.
JWT_SECRET=replace-with-a-long-random-value-at-least-32-characters

# [optional]
# Alternative name for JWT_SECRET. Used only if JWT_SECRET is unset.
SESSION_SECRET=

# [optional]
# Token lifetime, e.g. 30m, 8h, 7d. Defaults to 8h.
JWT_EXPIRES_IN=8h

# [optional]
# Failed sign-in attempts allowed per IP+email per 15 minutes. Defaults to 10.
LOGIN_RATE_LIMIT=10

# [optional]
# bcrypt cost factor for the seeded demo accounts (10-15). Defaults to 12.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Demo accounts
# -----------------------------------------------------------------------------
# These three accounts are created automatically on first boot so the project
# can be demonstrated without a registration flow. Each password MUST be set to
# a distinct value in production; the server refuses to start otherwise.
# Never reuse one password across all three.

# [required] [secret]
MANUFACTURER_PASSWORD=replace-with-a-unique-strong-password

# [required] [secret]
DISTRIBUTOR_PASSWORD=replace-with-a-different-strong-password

# [required] [secret]
RETAILER_PASSWORD=replace-with-a-third-different-strong-password

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------

# [optional]
# Injected automatically by Render. Do not hard-code a port.
PORT=10000

# [optional]
# Interface to bind. Containers must listen on 0.0.0.0 to be reachable.
HOST=0.0.0.0

# [optional]
# Set to "production" in production. Enables strict secret validation and
# refuses to fall back to the local development chain.
NODE_ENV=production

# [optional]
# Log level: trace, debug, info, warn, error. Defaults to info.
LOG_LEVEL=info

# [optional]
# Comma-separated list of browser origins allowed to call the API. Leave empty
# in production when the frontend is served by this same process (the default
# and recommended single-service setup).
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Blockchain
# -----------------------------------------------------------------------------
# Two supported modes. See DEPLOYMENT.md section "Blockchain strategy".
#
# MODE A - external EVM network (persistent ledger, recommended)
#   Set all three below. The server will NOT start a local chain.
#
# MODE B - local Hardhat node (zero cost, ephemeral ledger)
#   Leave all three below unset and set BLOCKCHAIN_ALLOW_LOCAL_CHAIN=true.
#   The chain lives in memory, so every restart redeploys the contract and
#   replays the database onto it. Ledger history is not permanent.

# [mode A] JSON-RPC endpoint of the target network. Leave unset for mode B.
BLOCKCHAIN_RPC_URL=

# [mode A] Address of the already-deployed SupplyChain contract. Leave unset to
#          let the server deploy a fresh contract (only appropriate for mode B).
CONTRACT_ADDRESS=

# [mode A] [secret]
#          Private key of the account that signs ledger transactions.
#          Use a dedicated key that holds only testnet funds.
#          NEVER use a Hardhat development account key, and never reuse a key
#          that holds real value.
PRIVATE_KEY=

# [mode B] Set to "true" to acknowledge that the local in-memory chain is
#          recreated on every restart. Required in production for mode B.
BLOCKCHAIN_ALLOW_LOCAL_CHAIN=false

# [optional] Path to the compiled contract artifact. Only needed if the artifact
#            is not at blockchain/artifacts/contracts/SupplyChain.sol/SupplyChain.json
BLOCKCHAIN_ARTIFACT_PATH=

# [optional] Milliseconds before a ledger read/write is treated as failed.
#            Defaults to 20000. Keeps a stalled RPC from exhausting the DB pool.
BLOCKCHAIN_TIMEOUT_MS=20000

# [optional] Milliseconds to wait for the local chain to answer at startup.
RPC_READY_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Frontend (build-time variables)
# -----------------------------------------------------------------------------
# These are read by Vite when the frontend is built, not by the API server.

# [optional] Public base path of the built frontend. Must be "/" when the app is
#            served from the domain root.
BASE_PATH=/

# [optional] Deployed HTTPS origin, e.g. https://your-app.onrender.com
#            Used for the QR code on product labels. When unset, the QR code uses
#            the origin the page is served from, which is already correct.
#            Development origins are rejected automatically.
VITE_PUBLIC_URL=
